{
  "title": "Submission",
  "metaDescription": "Submit your solution to the Global Reasoning Challenge Qualification Round. No login required — submitting your solution is how you enter.",
  "body": "<section class=\"page-hero\">\n  <div class=\"container\">\n    <div class=\"breadcrumb\"><a href=\"index.html\">Home</a> / Submission</div>\n    <span class=\"eyebrow on-dark\">Qualification Round 2026</span>\n    <h1>Submission</h1>\n    <p>Submit your solution to the Qualification Round and enter this year's Global Reasoning Challenge.</p>\n  </div>\n</section>\n<section>\n  <div class=\"container\" style=\"max-width:760px;\">\n    <div class=\"card\" style=\"margin-bottom:var(--space-8);\">\n      <p style=\"margin-bottom:0;\">Download the problem set below, solve the five reasoning problems on your own, then come back here and submit your answers before the deadline. There is no separate registration step &mdash; submitting your solution <strong>is</strong> how you enter the Qualification Round. No account or login is required.</p>\n    </div>\n    <div class=\"card\" style=\"margin-bottom:var(--space-8);\">\n      <h3>Qualification Round problem set</h3>\n      <p>Five reasoning problems (A&ndash;E) spanning deductive logic, probability, causal reasoning, strategic reasoning, and estimation. See <a href=\"rounds.html#compete\">Rounds &amp; Process</a> for full scoring details.</p>\n      <p style=\"margin-bottom:0;\"><a href=\"downloads/grc-qualification-round-problem-set.pdf\" download class=\"btn btn-primary\">Download problem set (PDF) &#8594;</a></p>\n    </div>\n\n    <form class=\"card form-card\" data-api=\"/api/submission\">\n      <h3>Submit your solution</h3>\n      <div class=\"form-field\">\n        <label for=\"s-name\">Full name</label>\n        <input type=\"text\" id=\"s-name\" name=\"fullName\" placeholder=\"As it should appear on your certificate\" required>\n      </div>\n      <div class=\"form-field\">\n        <label>Date of birth</label>\n        <div class=\"form-field-row\">\n          <select name=\"dobDay\" required aria-label=\"Day\">\n            <option value=\"\">Day</option>\n            <option value=\"1\">1</option>\n              <option value=\"2\">2</option>\n              <option value=\"3\">3</option>\n              <option value=\"4\">4</option>\n              <option value=\"5\">5</option>\n              <option value=\"6\">6</option>\n              <option value=\"7\">7</option>\n              <option value=\"8\">8</option>\n              <option value=\"9\">9</option>\n              <option value=\"10\">10</option>\n              <option value=\"11\">11</option>\n              <option value=\"12\">12</option>\n              <option value=\"13\">13</option>\n              <option value=\"14\">14</option>\n              <option value=\"15\">15</option>\n              <option value=\"16\">16</option>\n              <option value=\"17\">17</option>\n              <option value=\"18\">18</option>\n              <option value=\"19\">19</option>\n              <option value=\"20\">20</option>\n              <option value=\"21\">21</option>\n              <option value=\"22\">22</option>\n              <option value=\"23\">23</option>\n              <option value=\"24\">24</option>\n              <option value=\"25\">25</option>\n              <option value=\"26\">26</option>\n              <option value=\"27\">27</option>\n              <option value=\"28\">28</option>\n              <option value=\"29\">29</option>\n              <option value=\"30\">30</option>\n              <option value=\"31\">31</option>\n          </select>\n          <select name=\"dobMonth\" required aria-label=\"Month\">\n            <option value=\"\">Month</option>\n            <option value=\"1\">January</option><option value=\"2\">February</option><option value=\"3\">March</option>\n            <option value=\"4\">April</option><option value=\"5\">May</option><option value=\"6\">June</option>\n            <option value=\"7\">July</option><option value=\"8\">August</option><option value=\"9\">September</option>\n            <option value=\"10\">October</option><option value=\"11\">November</option><option value=\"12\">December</option>\n          </select>\n          <select name=\"dobYear\" required aria-label=\"Year\">\n            <option value=\"\">Year</option>\n            <option value=\"2015\">2015</option>\n              <option value=\"2014\">2014</option>\n              <option value=\"2013\">2013</option>\n              <option value=\"2012\">2012</option>\n              <option value=\"2011\">2011</option>\n              <option value=\"2010\">2010</option>\n              <option value=\"2009\">2009</option>\n              <option value=\"2008\">2008</option>\n              <option value=\"2007\">2007</option>\n              <option value=\"2006\">2006</option>\n              <option value=\"2005\">2005</option>\n              <option value=\"2004\">2004</option>\n              <option value=\"2003\">2003</option>\n              <option value=\"2002\">2002</option>\n              <option value=\"2001\">2001</option>\n              <option value=\"2000\">2000</option>\n              <option value=\"1999\">1999</option>\n              <option value=\"1998\">1998</option>\n              <option value=\"1997\">1997</option>\n              <option value=\"1996\">1996</option>\n              <option value=\"1995\">1995</option>\n          </select>\n        </div>\n        <small>Age determines your age group (Junior / Youth / Senior) and scoring threshold &mdash; see <a href=\"age-groups.html\">Age Groups</a>. Winners' ages are verified.</small>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"s-country\">Country</label>\n        <select id=\"s-country\" name=\"country\" required>\n          <option value=\"\">Select your country</option>\n          <option>Afghanistan</option><option>Albania</option><option>Algeria</option><option>Argentina</option>\n          <option>Australia</option><option>Austria</option><option>Bangladesh</option><option>Belgium</option>\n          <option>Brazil</option><option>Canada</option><option>Chile</option><option>China</option>\n          <option>Colombia</option><option>Egypt</option><option>France</option><option>Germany</option>\n          <option>Ghana</option><option>Greece</option><option>India</option><option>Indonesia</option>\n          <option>Ireland</option><option>Italy</option><option>Japan</option><option>Kenya</option>\n          <option>Malaysia</option><option>Mexico</option><option>Netherlands</option><option>Nigeria</option>\n          <option>Pakistan</option><option>Philippines</option><option>Poland</option><option>Portugal</option>\n          <option>Romania</option><option>Singapore</option><option>South Africa</option><option>South Korea</option>\n          <option>Spain</option><option>Sweden</option><option>Switzerland</option><option>Thailand</option>\n          <option>Turkey</option><option>Ukraine</option><option>United Kingdom</option><option>United States</option>\n          <option>Vietnam</option><option>Other</option>\n        </select>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"s-email\">Email</label>\n        <input type=\"email\" id=\"s-email\" name=\"email\" placeholder=\"you@example.com\" required>\n        <small>Used to send your results and, if you advance, Semi-Final instructions.</small>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"s-answers\">Your answers</label>\n        <textarea id=\"s-answers\" name=\"answers\" rows=\"8\" placeholder=\"Paste or summarize your solutions to Problems A-E here, with your reasoning for each.\" required></textarea>\n      </div>\n      <button type=\"submit\" class=\"btn btn-primary btn-block\">Submit solution</button>\n      <p class=\"form-status\" data-form-status></p>\n    </form>\n  </div>\n</section>\n"
}
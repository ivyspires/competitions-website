{
  "title": "Sign Up",
  "metaDescription": "Create a Global Reasoning Challenge account as a participant, teacher, ambassador, or school coordinator.",
  "body": "<section class=\"page-hero\">\n  <div class=\"container\">\n    <div class=\"breadcrumb\"><a href=\"index.html\">Home</a> / Sign Up</div>\n    <span class=\"eyebrow on-dark\">Create an account</span>\n    <h1>Sign Up</h1>\n    <p>Register as a participant, teacher, ambassador, or school coordinator to access your GRC account.</p>\n  </div>\n</section>\n<section>\n  <div class=\"container\">\n    <form class=\"card form-card\" data-api=\"/api/signup\" style=\"max-width:26rem; margin-inline:auto;\">\n      <h3>Create your account</h3>\n      <div class=\"form-field\">\n        <label for=\"su-role\">I am a&hellip;</label>\n        <select id=\"su-role\" name=\"role\" required>\n          <option value=\"participant\">Participant</option>\n          <option value=\"teacher\">Teacher</option>\n          <option value=\"ambassador\">Ambassador</option>\n          <option value=\"school\">School coordinator</option>\n        </select>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"su-name\">Full name</label>\n        <input type=\"text\" id=\"su-name\" name=\"name\" placeholder=\"Your name\" required>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"su-org\">School / organization (optional)</label>\n        <input type=\"text\" id=\"su-org\" name=\"organization\" placeholder=\"School or organization\">\n      </div>\n      <div class=\"form-field\">\n        <label for=\"su-email\">Email</label>\n        <input type=\"email\" id=\"su-email\" name=\"email\" placeholder=\"you@example.com\" required>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"su-password\">Password</label>\n        <input type=\"password\" id=\"su-password\" name=\"password\" placeholder=\"At least 8 characters\" minlength=\"8\" required>\n      </div>\n      <button type=\"submit\" class=\"btn btn-dark btn-block\">Create account</button>\n      <p class=\"form-status\" data-form-status></p>\n      <p class=\"text-muted\" style=\"margin-top:var(--space-4); font-size:var(--text-sm);\">Already have an account? <a href=\"login.html\">Log in</a></p>\n    </form>\n  </div>\n</section>\n"
}
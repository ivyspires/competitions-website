{
  "title": "Log In",
  "metaDescription": "Log in to your Global Reasoning Challenge account.",
  "body": "<section class=\"page-hero\">\n  <div class=\"container\">\n    <div class=\"breadcrumb\"><a href=\"index.html\">Home</a> / Log In</div>\n    <span class=\"eyebrow on-dark\">Welcome back</span>\n    <h1>Log In</h1>\n    <p>Sign in to your GRC account to view your dashboard.</p>\n  </div>\n</section>\n<section>\n  <div class=\"container\">\n    <form class=\"card form-card\" data-api=\"/api/login\" style=\"max-width:26rem; margin-inline:auto;\">\n      <h3>Log in</h3>\n      <div class=\"form-field\">\n        <label for=\"li-email\">Email</label>\n        <input type=\"email\" id=\"li-email\" name=\"email\" placeholder=\"you@example.com\" required>\n      </div>\n      <div class=\"form-field\">\n        <label for=\"li-password\">Password</label>\n        <input type=\"password\" id=\"li-password\" name=\"password\" placeholder=\"Your password\" required>\n      </div>\n      <button type=\"submit\" class=\"btn btn-dark btn-block\">Log in</button>\n      <p class=\"form-status\" data-form-status></p>\n      <p class=\"text-muted\" style=\"margin-top:var(--space-4); font-size:var(--text-sm);\">Don&rsquo;t have an account? <a href=\"signup.html\">Sign up</a></p>\n    </form>\n  </div>\n</section>\n"
}